# Public URL of the site (used for canonical URLs, OG images and WhatsApp share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL + PostGIS (Supabase: Project settings > Database)
DATABASE_URL="postgresql://postgres:password@localhost:5432/go_search_property?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/go_search_property?schema=public"

# Supabase (auth + storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Typesense search
TYPESENSE_HOST=
TYPESENSE_API_KEY=
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=

# Maps (MapLibre style URL, e.g. from MapTiler)
NEXT_PUBLIC_MAP_STYLE_URL=

# Secret salt for hashing visitor IPs (rate limiting, Data Privacy Act). Any long random string, e.g. `openssl rand -hex 32`
LEAD_IP_SALT=
