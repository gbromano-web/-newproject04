# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables. The Supabase–Vercel integration
# sets the POSTGRES_* and SUPABASE_* ones for you.
# Never commit real values.

# ─── Site ────────────────────────────────────────────────────────────────────
# Public address of the site: canonical URLs, sitemap, share links, email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "database" = show real listings from Supabase and open agent sign-in.
# Leave unset to run on the built-in sample listings (preview banner, no indexing,
# inquiries switched off, sample dashboard behind DASHBOARD_USER/PASSWORD).
# Read at build time: redeploy after changing it.
NEXT_PUBLIC_LISTINGS_SOURCE=

# ─── Database (PostgreSQL + PostGIS on Supabase) ─────────────────────────────
# Transaction pooler, port 6543 (Supabase: Connect > Transaction pooler).
# The site uses DATABASE_URL if set, otherwise POSTGRES_URL from the integration.
DATABASE_URL="postgresql://postgres:password@localhost:5432/go_search_property"
# POSTGRES_URL=
# Direct connection (port 5432), only for `npm run db:postgis`
DIRECT_URL="postgresql://postgres:password@localhost:5432/go_search_property"
# Optional: Supabase root certificate (PEM, \n for newlines) to verify the database's TLS certificate
# DATABASE_SSL_CA=
# Optional: connections per server instance (default 5)
# DATABASE_POOL_MAX=5

# ─── Supabase (agent sign-in and listing photos) ─────────────────────────────
# Project URL and the publishable (or legacy anon) key. Both are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Also accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_ANON_KEY
# The site does not use the service-role or secret key; do not add it.

# ─── Security ────────────────────────────────────────────────────────────────
# Secret salt for hashing visitor IPs (rate limiting, Data Privacy Act) and signing form timers.
# Any long random string, e.g. `openssl rand -hex 32`. Required in production.
LEAD_IP_SALT=

# Sign-up: breach check endpoint (Have I Been Pwned range API; only 5 characters of a SHA-1 are sent)
# and the minimum seconds to fill in the form. Defaults shown; tests override both.
# PWNED_PASSWORDS_URL=https://api.pwnedpasswords.com
# SIGNUP_MIN_SECONDS=3

# Sample mode only: one shared login for the sample agent dashboard.
# Not used once NEXT_PUBLIC_LISTINGS_SOURCE=database (agents sign in with Supabase).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Demo servers only: accept inquiries without a database (logged, not stored).
# Leave unset in production, where a missing database makes inquiries fail with 503 instead of being lost.
# LEADS_LOG_ONLY=1

# Agent plans: Stripe (UAE account). Without both keys the billing page says payments are off.
# Secret key: Stripe dashboard > Developers > API keys (sk_live_... or sk_test_...). Never commit it.
# Webhook secret: Developers > Webhooks > endpoint https://gosearchproperty.com/api/stripe/webhook (whsec_...)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# 1 = let Stripe Tax add VAT (set up Stripe Tax registrations first)
# STRIPE_AUTOMATIC_TAX=
# Real payments: a live key (sk_live_) is refused unless this is exactly "true" AND
# SITE.legalReviewed is true in src/lib/site.ts (the lawyer's sign-off, in a commit).
# LIVE_PAYMENTS_APPROVED=
# Daily Stripe reconciliation (/api/cron/billing-reconcile): a long random string.
# Vercel's cron sends it as "Authorization: Bearer ..."; unset = the job does nothing.
# CRON_SECRET=
# Tests only: send Stripe API calls to the local stand-in
# STRIPE_API_BASE=

# Email through Resend (docs/PLAYBOOK.md 3.21). Without a key, emails are skipped.
# RESEND_API_KEY=
# EMAIL_FROM=Go Search Property <hello@gosearchproperty.com>
# Who may use /admin/agents and gets new-application emails (comma-separated)
# ADMIN_EMAILS=
# Tests only: send Resend calls to the local stand-in
# RESEND_API_BASE=

# Set automatically on Vercel and GitHub; shown by /api/health
# VERCEL_GIT_COMMIT_SHA=
# GIT_COMMIT=
